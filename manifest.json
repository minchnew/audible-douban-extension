{
  "manifest_version": 3,
  "name": "Audible + Douban",
  "version": "1.0.1",
  "default_locale": "en",
  "description": "__MSG_extensionDescription__",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [],
  "host_permissions": [
    "https://www.audible.com/pd/*",
    "https://audible.com/pd/*",
    "https://search.douban.com/book/*",
    "https://book.douban.com/subject/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.audible.com/pd/*", "https://audible.com/pd/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
